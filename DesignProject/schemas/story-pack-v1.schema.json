    },
    "schemaVersion": {
      "const": "rpg-story-pack/1.0",
      "default": "rpg-story-pack/1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "sourceDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sourcedigest",
      "type": "string"
    },
    "sourceRevision": {
